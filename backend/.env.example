MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=servicio_social
API_PREFIX=/api/v1

# Opcional: reintentos al arrancar (Atlas / red)
# MONGODB_CONNECT_RETRIES=8
# MONGODB_CONNECT_RETRY_DELAY_SEC=1.5
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Mongo local sin Docker: instala MongoDB o usa: docker compose up -d

# Atlas / TLS (Python 3.13+ o Windows): si sigue "SSL handshake failed":
# 1) Con Atlas, en Windows o Python ≥ 3.13 el backend usa tlsInsecure por defecto (PyMongo no admite tlsContext aquí).
#    Desactivar: MONGODB_TLS_RELAX_WINDOWS_ATLAS=false
# 2) Forzar relajación total: MONGODB_TLS_INSECURE=true (solo desarrollo)
# 3) Mongo local: MONGODB_URI=mongodb://localhost:27017 y docker compose up -d
