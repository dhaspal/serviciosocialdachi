# Copia a `.env` y ajusta.

VITE_APP_NAME=Institución Educativa Indígena Técnica Agropecuaria Dachi Dada Kera
# Host del backend FastAPI (sin /api/v1; evita /api/v1/api/v1 en las URLs).
# Desarrollo: http://localhost:8000
# Render/producción: déjalo vacío (el sitio y el API comparten el mismo origen).
VITE_API_BASE_URL=http://localhost:8000
# Debe coincidir con API_PREFIX del backend (por defecto /api/v1)
VITE_API_PREFIX=/api/v1
VITE_PUBLIC_API_KEY=
VITE_ENABLE_ANALYTICS=false

# Contacto institucional (público en el sitio)
VITE_INST_EMAIL=contacto@cedachidadakera.com
VITE_INST_PHONE=+57 6 000 0000
VITE_INST_MOBILE=+57 300 000 0000
# WhatsApp en formato E.164 sin +
VITE_INST_WHATSAPP_E164=573001234567
VITE_INST_ADDRESS=Territorio Embera Chamí, Risaralda, Colombia

# Google Maps: URL del iframe "embed" (Compartir > Insertar mapa)
VITE_GOOGLE_MAPS_EMBED_URL=

VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
