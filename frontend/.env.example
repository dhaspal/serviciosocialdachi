# Copia a `.env` y ajusta.

# Host del backend FastAPI (sin /api/v1; evita /api/v1/api/v1 en las URLs).
# Desarrollo: http://localhost:8000
# Render/producción: déjalo vacío (el sitio y el API comparten el mismo origen).
VITE_API_BASE_URL=http://localhost:8000
# Debe coincidir con API_PREFIX del backend (por defecto /api/v1)
VITE_API_PREFIX=/api/v1
VITE_PUBLIC_API_KEY=
VITE_ENABLE_ANALYTICS=false
